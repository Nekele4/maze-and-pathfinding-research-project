<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="dingaling" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/dingaling" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../dingaling" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add library="raylib" />
					<Add library="opengl32" />
					<Add library="gdi32" />
					<Add library="winmm" />
					<Add library="pthread" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/dingaling" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="src/algos" />
			<Add directory="src/core" />
			<Add directory="src/demo" />
			<Add directory="src/tester" />
		</Compiler>
		<Unit filename="src/algos/algorithms.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/algos/algorithms.h" />
		<Unit filename="src/algos/astar.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/algos/astar.h" />
		<Unit filename="src/algos/bfs.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/algos/bfs.h" />
		<Unit filename="src/algos/dfs.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/algos/dfs.h" />
		<Unit filename="src/algos/dijkstra.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/algos/dijkstra.h" />
		<Unit filename="src/core/maze.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/core/maze.h" />
		<Unit filename="src/core/pathing.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/core/pathing.h" />
		<Unit filename="src/core/results.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/core/results.h" />
		<Unit filename="src/demo/bfsdraw.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/demo/dfsdraw.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/demo/drawalgo.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/demo/drawalgo.h" />
		<Unit filename="src/demo/main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/tester/testbuilder.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/tester/testbuilder.h" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
